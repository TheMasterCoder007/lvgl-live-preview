{
	"name": "lvgl-live-preview",
	"displayName": "LVGL Live Preview",
	"description": "Live preview for LVGL C code with automatic hot-reload using Emscripten",
	"icon": "assets/icon.png",
	"version": "0.0.1",
	"publisher": "themastercoder007",
	"repository": {
		"type": "git",
		"url": "https://github.com/themastercoder007/lvgl-live-preview"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Visualization",
		"Other"
	],
	"keywords": [
		"lvgl",
		"embedded",
		"gui",
		"preview",
		"emscripten",
		"wasm"
	],
	"activationEvents": [
		"onCommand:lvgl-preview.start",
		"onLanguage:c"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "lvgl-preview.start",
				"title": "LVGL: Start Live Preview",
				"category": "LVGL Preview"
			},
			{
				"command": "lvgl-preview.stop",
				"title": "LVGL: Stop Preview",
				"category": "LVGL Preview"
			},
			{
				"command": "lvgl-preview.rebuild",
				"title": "LVGL: Force Rebuild",
				"category": "LVGL Preview"
			},
			{
				"command": "lvgl-preview.clearCache",
				"title": "LVGL: Clear Cache",
				"category": "LVGL Preview"
			},
			{
				"command": "lvgl-preview.checkSetup",
				"title": "LVGL: Check Setup",
				"category": "LVGL Preview"
			},
			{
				"command": "lvgl-preview.reinstallToolchain",
				"title": "LVGL: Reinstall Emscripten Toolchain",
				"category": "LVGL Preview"
			}
		],
		"keybindings": [
			{
				"command": "lvgl-preview.start",
				"key": "ctrl+shift+l",
				"mac": "cmd+shift+l",
				"when": "resourceLangId == c"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "lvgl-preview.start",
					"when": "resourceLangId == c",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "lvgl-preview.start",
					"when": "resourceLangId == c",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && npm run copy-assets",
		"copy-assets": "node -e \"require('fs').copyFileSync('src/preview/preview.html', 'out/preview/preview.html')\"",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.7",
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^8.54.0",
		"@typescript-eslint/parser": "^8.54.0",
		"@vscode/test-electron": "^2.3.8",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^9.39.4",
		"prettier": "^3.7.4",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"adm-zip": "^0.5.10"
	}
}
